#ifndef WIFI_CREDENTIALS_H
#define WIFI_CREDENTIALS_H

/**
 * @file wifi_credentials.h.example
 * @brief Template for Wi-Fi station configuration.
 *
 * HOW TO USE:
 * 1. Copy this file as "wifi_credentials.h":
 *    cp wifi_credentials.h.example wifi_credentials.h
 * 2. Set your actual Wi-Fi SSID and Password below.
 * 3. Note that "wifi_credentials.h" is ignored by Git (.gitignore) to keep secrets safe.
 *
 * ALTERNATIVELY:
 * You can also store credentials dynamically on SPIFFS (/spiffs/wifi.txt)
 * formatted as:
 * SSID;PASSWORD
 */

#define CONFIG_WIFI_SSID     "YOUR_WIFI_SSID"
#define CONFIG_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

#endif // WIFI_CREDENTIALS_H
